<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sai Charan Portfolio</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#050b18;
    color:white;
}

.container{
    width:90%;
    margin:auto;
}

.hero{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:50px 0;
    flex-wrap:wrap;
}

.hero-text{
    max-width:500px;
}

.hero-text h3{
    color:#0d6efd;
    margin-bottom:10px;
}

.hero-text h1{
    font-size:55px;
}

.hero-text span{
    color:#0d6efd;
}

.hero-text h2{
    margin:15px 0;
    color:#ddd;
}

.hero-text p{
    color:#bbb;
    line-height:1.7;
}

.btn{
    display:inline-block;
    margin-top:20px;
    padding:12px 25px;
    background:#0d6efd;
    color:white;
    text-decoration:none;
    border-radius:8px;
}

.profile-img{
    width:350px;
    height:420px;
    object-fit:cover;
    border-radius:20px;
    border:3px solid #0d6efd;
    box-shadow:0 0 20px #0d6efd;
}

section{
    margin-top:50px;
}

.title{
    color:#0d6efd;
    margin-bottom:20px;
    font-size:32px;
}

.about,.resume{
    background:#0b1324;
    padding:20px;
    border-radius:15px;
}

.skills{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:20px;
}

.skill{
    background:#0b1324;
    padding:25px;
    text-align:center;
    border-radius:15px;
    border:1px solid #0d6efd;
}

.projects{
    display:grid;
    gap:20px;
}

.project{
    background:#0b1324;
    padding:20px;
    border-radius:15px;
    border:1px solid #0d6efd;
}

.project a{
    color:#0d6efd;
    text-decoration:none;
}

.contact{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.contact-box{
    background:#0b1324;
    padding:20px;
    border-radius:15px;
    text-align:center;
}

footer{
    text-align:center;
    padding:20px;
    margin-top:40px;
    border-top:1px solid #0d6efd;
}
</style>
</head>

<body>

<div class="container">

    <section class="hero">
        <div class="hero-text">
            <h3>Hello, I'm</h3>
            <h1>Sai <span>Charan</span></h1>
            <h2>Website Developer | Student</h2>

            <p>
                I build responsive, user-friendly websites with
                clean code and modern design.
            </p>

            <a href="#" class="btn">Download Resume</a>
        </div>

        <img src="imp.jpg" alt="Sai Charan" class="profile-img">
    </section>

    <section>
        <h2 class="title">About Me</h2>

        <div class="about">
            Motivated student seeking opportunities to apply and improve
            web development skills in HTML, CSS, JavaScript, Java and PHP.
            I enjoy creating efficient, responsive and visually appealing websites.
        </div>
    </section>

    <section>
        <h2 class="title">My Skills</h2>

        <div class="skills">
            <div class="skill">HTML</div>
            <div class="skill">CSS</div>
            <div class="skill">JavaScript</div>
            <div class="skill">Java</div>
            <div class="skill">PHP</div>
        </div>
    </section>

    <section>
        <h2 class="title">My Projects</h2>

        <div class="projects">

            <div class="project">
                <h3>Personal Portfolio Website</h3>
                <p>
                    Responsive portfolio website built using HTML and CSS.
                </p>
                <br>
                <a href="#">View Project</a>
            </div>

            <div class="project">
                <h3>Calculator Web Application</h3>
                <p>
                    Calculator using HTML, CSS and JavaScript.
                </p>
                <br>
                <a href="#">View Project</a>
            </div>

        </div>
    </section>

    <section>
        <h2 class="title">Resume</h2>

        <div class="resume">
            Download my resume to know more about my education,
            skills and experience.
            <br><br>
            <a href="#" class="btn">Download Resume</a>
        </div>
    </section>

    <section>
        <h2 class="title">Contact Me</h2>

        <div class="contact">

            <div class="contact-box">
                <h3>Phone</h3>
                <p>8688528868</p>
            </div>

            <div class="contact-box">
                <h3>Email</h3>
                <p>charanchirra44@gmail.com</p>
            </div>

            <div class="contact-box">
                <h3>Location</h3>
                <p>Hyderabad, India</p>
            </div>

        </div>
    </section>

</div>

<footer>
    © 2026 Sai Charan. All Rights Reserved.
</footer>

</body>
</html>
